<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.CheliangxinxiDao">

    <!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.CheliangxinxiEntity" id="cheliangxinxiMap">
        <result property="chepaihao" column="chepaihao"/>
        <result property="chexing" column="chexing"/>
        <result property="cheshenyanse" column="cheshenyanse"/>
        <result property="cheliangtupian" column="cheliangtupian"/>
        <result property="cheliangpinpai" column="cheliangpinpai"/>
        <result property="cheliangxinghao" column="cheliangxinghao"/>
        <result property="yonghuzhanghao" column="yonghuzhanghao"/>
        <result property="yonghuxingming" column="yonghuxingming"/>
