<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.WeixiuyuanDao">

    <!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.WeixiuyuanEntity" id="weixiuyuanMap">
        <result property="weixiuzhanghao" column="weixiuzhanghao"/>
        <result property="mima" column="mima"/>
        <result property="weixiuxingming" column="weixiuxingming"/>
        <result property="touxiang" column="touxiang"/>
        <result property="xingbie" column="xingbie"/>
        <result property="lianxidianhua" column="lianxidianhua"/>
        <result property="shenfenzhenghao" column="shenfenzhenghao"/>
        <result property="sfsh" column="sfsh"/>
        <result property="shhf" column="shhf"/>
