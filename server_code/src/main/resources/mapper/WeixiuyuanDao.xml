    <select id="selectListView"
            resultType="com.cl.entity.view.WeixiuyuanView">

        SELECT weixiuyuan.* FROM weixiuyuan weixiuyuan
        <where>1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectView"
            resultType="com.cl.entity.view.WeixiuyuanView">
        SELECT * FROM weixiuyuan weixiuyuan
        <where>1=1 ${ew.sqlSegment}</where>
    </select>


</mapper>
