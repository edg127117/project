iew li.el-sub-menu .el-sub-menu__title .el-icon-location{\n    vertical-align: middle;\n    margin: 0px 5px 0px 0px;\n    width: 20px;\n    text-align: center;\n    font-size: 20px;\n    color: inherit;\n}\n/* item */\n.menu_view li.el-sub-menu .el-sub-menu__title{\n    padding: 0px 10px 0px 20px;\n    color: #987ade;\n    background: url(http://clfile.zggen.cn/20241106/6586eb2b7d744462adb1107d78a0af18.png) no-repeat center top;\n    height: 70px;\n    line-height: 66px;\n    border-width: 0px 0px 0px;\n    border-style: solid;\n    border-color: rgba(255, 255, 255,.3);\n    font-weight: 600;\n    margin: 0px;\n    transition: all 0s ease 0s;\n}\n/* 悬浮*/\n.menu_view li.el-sub-menu .el-sub-menu__title:hover{\n    color: #111;\n    border-radius: 4px;\n}\n/* 选中 */\n.menu_view li.el-sub-menu .el-sub-menu__title.is-active{\n    color: #111;\n    border-radius: 4px;\n}\n/* 箭头*/\n.menu_view li.el-sub-menu .el-sub-menu__title .el-sub-menu__icon-arrow{\n    position: absolute;\n    margin: -6px 0px 0px 8px;\n    font-size: 12px;\n    vertical-align: middle;\n    color: inherit;\n    right: 20px;\n}\n.menu_view li.el-menu-item{\n    padding: 0px 10px 0px 20px;\n    color: #987ade;\n    background: url(http://clfile.zggen.cn/20241106/6586eb2b7d744462adb1107d78a0af18.png) no-repeat center top;\n    height: 70px;\n    line-height: 66px;\n    border-width: 0 0 0px;\n    border-style: solid;\n    border-color: rgba(255, 255, 255,.3);\n    font-weight: 600;\n    margin: 0px 0px 10px;\n    transition: all 0s ease 0s;\n}\n.menu_view li.el-menu-item:hover{\n    color: #111;\n    border-radius: 4px;\n}\n.menu_view li.el-menu-item.is-active{\n    color: #111;\n    border-radius: 4px;\n}\n\n/* 二级菜单 */\n/* 盒子 */\n.menu_view li .el-menu--inline{\n    border: none;\n    padding: 0 20px;\n    background: none;\n    width: auto;\n    margin: 5px 0;\n    box-sizing: border-box;\n}\n/* item */\n.menu_view li .el-menu--inline .second-item{\n    display: block;\n    padding:0!important;\n    hei